# SecureGate AI — Environment Configuration
# Copy to .env and adjust values for your environment.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-long-random-string

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=network_security
DB_POOL_MIN=1
DB_POOL_MAX=10

# Reports output directory
REPORTS_DIR=reports/output

# OpenAI (optional — used by AI explanation engine)
OPENAI_API_KEY=
